---
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="mx-auto flex w-full max-w-5xl flex-col gap-4 px-6 py-10 text-sm text-muted md:flex-row md:items-center md:justify-between md:px-10"
  >
    <div class="flex flex-col gap-1">
      <p class="text-ink">Build. Experiment. Share.</p>
      <p class="text-xs">© {year} Raymundo Ycaza · ranydev</p>
    </div>

    <div class="flex items-center gap-5 text-xs">
      <a
        href="https://x.com/ranydev"
        rel="noopener noreferrer"
        target="_blank"
        class="transition-colors hover:text-ink">X</a
      >
      <a
        href="https://github.com/RaymundoYcaza"
        rel="noopener noreferrer"
        target="_blank"
        class="transition-colors hover:text-ink">GitHub</a
      >
      <a
        href="https://www.linkedin.com/in/raymundoycaza"
        rel="noopener noreferrer"
        target="_blank"
        class="transition-colors hover:text-ink">LinkedIn</a
      >
      <span class="text-faint">·</span>
      <a
        href="https://www.youtube.com/@ranydev"
        rel="noopener noreferrer"
        target="_blank"
        class="transition-colors hover:text-ink">YouTube</a
      >
    </div>
  </div>
</footer>
