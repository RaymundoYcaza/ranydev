---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
const date = pubDate.toLocaleDateString("es-ES", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article
  class="group border-b border-line py-8 first:border-t first:pt-0 last:border-b-0"
>
  <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
    <time
      datetime={pubDate.toISOString()}
      class="shrink-0 pt-1 font-mono text-xs tabular-nums text-muted"
    >
      {date}
    </time>
    <div class="flex-1">
      <h3 class="font-display text-xl font-semibold tracking-tight sm:text-2xl">
        <a
          href={href}
          class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size,color] duration-300 group-hover:bg-[length:100%_1px] hover:text-amber"
        >
          {title}
        </a>
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <li class="font-mono text-[11px] uppercase tracking-wider text-steel">
                {tag}
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>
