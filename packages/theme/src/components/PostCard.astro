---
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
  video?: string;
  readingMinutes?: number;
}

const {
  href,
  title,
  description,
  pubDate,
  tags = [],
  video,
  readingMinutes,
} = Astro.props;
const date = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<article
  class="group border-b border-line py-8 first:border-t first:pt-0 last:border-b-0"
>
  <div class="flex flex-col gap-2 sm:flex-row sm:gap-6">
    <time
      datetime={pubDate.toISOString()}
      class="shrink-0 pt-1 font-mono text-xs tabular-nums text-faint sm:w-24"
    >
      {date}
    </time>
    <div class="flex-1">
      <h3 class="text-xl font-semibold tracking-tight sm:text-2xl">
        <a
          href={href}
          class="bg-[linear-gradient(var(--color-accent-strong),var(--color-accent-strong))] bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-300 group-hover:bg-[length:100%_1px]"
        >
          {title}
        </a>
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
      {
        (tags.length > 0 || video || readingMinutes) && (
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <span class="rounded-full bg-accent px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-ink-bold">
                {tag}
              </span>
            ))}
            {video && (
              <a
                href={video}
                rel="noopener noreferrer"
                target="_blank"
                class="rounded-full bg-accent-strong px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-bg transition-opacity hover:opacity-80"
              >
                video ↗
              </a>
            )}
            {readingMinutes && (
              <span class="font-mono text-[11px] tabular-nums text-faint">
                {readingMinutes} min read
              </span>
            )}
          </div>
        )
      }
    </div>
  </div>
</article>
