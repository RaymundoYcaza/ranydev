---
interface Props {
  title: string;
  description: string;
  tech: string[];
  href?: string;
  repo?: string;
  demo?: string;
  kind?: string;
  status?: string;
}

const { title, description, tech, href, repo, demo, kind, status } =
  Astro.props;
---

<article
  class="flex h-full flex-col gap-4 rounded-xl border border-line bg-card p-6 transition-colors duration-300 hover:border-accent-strong"
>
  <div class="flex items-start justify-between gap-4">
    <h3 class="text-lg font-semibold tracking-tight">
      {
        href ? (
          <a href={href} class="transition-colors hover:text-muted">
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <div class="flex shrink-0 gap-3 font-mono text-xs">
      {
        repo && (
          <a
            href={repo}
            rel="noopener noreferrer"
            target="_blank"
            class="text-muted transition-colors hover:text-ink"
          >
            repo
          </a>
        )
      }
      {
        demo && (
          <a
            href={demo}
            rel="noopener noreferrer"
            target="_blank"
            class="text-muted transition-colors hover:text-ink"
          >
            demo
          </a>
        )
      }
    </div>
  </div>
  <p class="text-sm leading-relaxed text-muted">{description}</p>
  <div class="mt-auto flex flex-wrap items-center gap-2 pt-2">
    {
      kind && (
        <span class="rounded-full border border-accent bg-accent px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-ink-bold">
          {kind}
        </span>
      )
    }
    {
      status && (
        <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] uppercase tracking-wider text-faint">
          {status}
        </span>
      )
    }
    {
      tech.map((t) => (
        <span class="rounded-full border border-line px-2.5 py-0.5 font-mono text-[11px] text-faint">
          {t}
        </span>
      ))
    }
  </div>
</article>
