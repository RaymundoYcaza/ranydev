---
const nav = [
  { href: "/work", label: "Work" },
  { href: "/notes", label: "Notes" },
  { href: "/about", label: "About" },
];

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => pathname.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/80 backdrop-blur">
  <div class="mx-auto flex w-full max-w-5xl items-center justify-between px-6 py-4 md:px-10">
    <a href="/" class="flex items-center" aria-label="ranydev, home">
      <img
        src="/ranydev-wordmark.svg"
        alt="ranydev"
        width="120"
        height="30"
        class="h-6 w-auto md:h-7"
      />
    </a>

    <div class="flex items-center gap-6">
      <nav class="flex items-center gap-5 md:gap-7">
        {
          nav.map(({ href, label }) => (
            <a
              href={href}
              class:list={[
                "text-sm transition-colors",
                isActive(href)
                  ? "text-ink border-b border-accent pb-1"
                  : "text-muted hover:text-ink",
              ]}
              aria-current={isActive(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-4 border-l border-line pl-5">
        <a
          href="https://x.com/ranydev"
          rel="noopener noreferrer"
          target="_blank"
          class="text-muted transition-colors hover:text-ink"
          aria-label="X"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </a>
        <a
          href="https://github.com/RaymundoYcaza"
          rel="noopener noreferrer"
          target="_blank"
          class="text-muted transition-colors hover:text-ink"
          aria-label="GitHub"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.73.5.5 5.73.5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.71-1.3-1.71-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12C23.5 5.73 18.27.5 12 .5Z" />
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/raymundoycaza"
          rel="noopener noreferrer"
          target="_blank"
          class="text-muted transition-colors hover:text-ink"
          aria-label="LinkedIn"
        >
          <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>
