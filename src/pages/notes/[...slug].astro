---
import { getCollection, render } from "astro:content";
import { BaseLayout, PostCard } from "@ranydev/theme";
import "../../styles/global.css";

export async function getStaticPaths() {
  const notes = await getCollection("notes", ({ data }) => !data.draft);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);

const date = note.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const updated = note.data.updatedDate?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const words = (note.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(words / 220));

const all = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const index = all.findIndex((n) => n.id === note.id);
const newer = index > 0 ? all[index - 1] : null;
const older = index < all.length - 1 ? all[index + 1] : null;

const related = all
  .filter(
    (n) =>
      n.id !== note.id &&
      n.data.tags.some((t) => note.data.tags.includes(t)),
  )
  .slice(0, 3);
const relatedMeta = related.map((n) => {
  const w = (n.body ?? "").trim().split(/\s+/).filter(Boolean).length;
  return { note: n, readingMinutes: Math.max(1, Math.ceil(w / 220)) };
});
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <article class="max-w-3xl">
    <header>
      <a
        href="/notes"
        class="font-mono text-xs uppercase tracking-[0.2em] text-muted transition-colors hover:text-ink"
        >← back to notes</a
      >
      <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
        <time
          datetime={note.data.pubDate.toISOString()}
          class="font-mono text-xs tabular-nums text-faint"
        >
          {date}
        </time>
        <span class="font-mono text-xs tabular-nums text-faint">
          {readingMinutes} min read
        </span>
        {
          updated && (
            <span class="font-mono text-xs tabular-nums text-faint">
              Updated {updated}
            </span>
          )
        }
      </div>
      <h1
        class="mt-3 text-4xl font-semibold leading-[1.05] tracking-tight md:text-5xl"
      >
        {note.data.title}
      </h1>
      <p class="mt-4 max-w-xl leading-relaxed text-muted">
        {note.data.description}
      </p>
      {
        (note.data.tags.length > 0 || note.data.video) && (
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {note.data.tags.map((tag) => (
              <span class="rounded-full bg-accent px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-ink-bold">
                {tag}
              </span>
            ))}
            {note.data.video && (
              <a
                href={note.data.video}
                rel="noopener noreferrer"
                target="_blank"
                class="rounded-full bg-accent-strong px-2 py-0.5 font-mono text-[11px] uppercase tracking-wider text-bg transition-opacity hover:opacity-80"
              >
                video ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    <div class="prose mt-10">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav
          class="mt-16 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:justify-between"
          aria-label="Note navigation"
        >
          {older ? (
            <a
              href={`/notes/${older.id}`}
              class="group max-w-xs"
            >
              <span class="font-mono text-xs uppercase tracking-wider text-faint">
                ← older
              </span>
              <span class="mt-1 block text-sm font-medium text-ink transition-colors group-hover:text-accent-strong">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a
              href={`/notes/${newer.id}`}
              class="group max-w-xs sm:text-right"
            >
              <span class="font-mono text-xs uppercase tracking-wider text-faint">
                newer →
              </span>
              <span class="mt-1 block text-sm font-medium text-ink transition-colors group-hover:text-accent-strong">
                {newer.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }

    {
      relatedMeta.length > 0 && (
        <section class="mt-16 border-t border-line pt-8">
          <h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
            Related
          </h2>
          <div class="mt-2">
            {relatedMeta.map(({ note: n, readingMinutes: rm }) => (
              <PostCard
                href={`/notes/${n.id}`}
                title={n.data.title}
                description={n.data.description}
                pubDate={n.data.pubDate}
                tags={n.data.tags}
                video={n.data.video}
                readingMinutes={rm}
              />
            ))}
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
