---
import { getCollection } from "astro:content";
import { BaseLayout, PostCard } from "@ranydev/theme";
import "../../styles/global.css";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Notes"
  description="Engineering notes on building software, tools, and experiments — written as I ship."
>
  <header class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">notes</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">
      Engineering Notes
    </h1>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">
      Short, practical write-ups on what I'm building and what I learn along
      the way.
    </p>
  </header>

  <div class="mt-12">
    {
      notes.length === 0 ? (
        <p class="font-mono text-sm text-muted">
          No notes yet. Check back soon.
        </p>
      ) : (
        notes.map((note) => (
          <PostCard
            href={`/notes/${note.id}`}
            title={note.data.title}
            description={note.data.description}
            pubDate={note.data.pubDate}
            tags={note.data.tags}
            video={note.data.video}
          />
        ))
      )
    }
  </div>
</BaseLayout>
