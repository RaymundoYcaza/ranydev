---
import { getCollection } from "astro:content";
import { BaseLayout, PostCard, ProjectCard } from "@ranydev/theme";
import "../styles/global.css";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
---

<BaseLayout
  title="Inicio"
  description="RanyDev — Raymundo Ycaza, software developer. Escribo sobre código, arquitectura y herramientas, y comparto los proyectos en los que trabajo."
>
  <section>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber">
      software developer
    </p>
    <h1
      class="mt-4 font-display text-4xl font-semibold leading-[1.1] tracking-tight md:text-5xl"
    >
      Construyo software y escribo sobre el proceso.
    </h1>
    <p class="mt-6 max-w-xl leading-relaxed text-muted">
      Soy Raymundo. Diseño y desarrollo aplicaciones web, y aquí documento lo
      que aprendo sobre código, arquitectura y herramientas.
    </p>
    <div class="mt-8 flex gap-6 font-mono text-sm">
      <a
        href="/blog"
        class="text-amber transition-colors hover:text-paper">blog →</a
      >
      <a
        href="/projects"
        class="text-amber transition-colors hover:text-paper">proyectos →</a
      >
    </div>
  </section>

  <section class="mt-20">
    <h2
      class="flex items-baseline justify-between border-b border-line pb-3 font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      últimas publicaciones
      <a
        href="/blog"
        class="text-amber normal-case tracking-normal transition-colors hover:text-paper"
        >ver todo</a
      >
    </h2>
    <div class="mt-2">
      {
        posts.map((post) => (
          <PostCard
            href={`/blog/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-20">
    <h2
      class="flex items-baseline justify-between border-b border-line pb-3 font-mono text-xs uppercase tracking-[0.2em] text-muted"
    >
      proyectos destacados
      <a
        href="/projects"
        class="text-amber normal-case tracking-normal transition-colors hover:text-paper"
        >ver todo</a
      >
    </h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {
        projects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            repo={project.data.repo}
            demo={project.data.demo}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
