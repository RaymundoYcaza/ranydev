---
import { getCollection } from "astro:content";
import { BaseLayout, ProjectCard } from "@ranydev/theme";
import "../../styles/global.css";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Proyectos"
  description="Proyectos de software en los que he trabajado: herramientas, sitios y experimentos."
>
  <header>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-amber">
      proyectos
    </p>
    <h1
      class="mt-4 font-display text-4xl font-semibold tracking-tight md:text-5xl"
    >
      Proyectos
    </h1>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">
      Herramientas, sitios y experimentos en los que trabajo.
    </p>
  </header>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      projects.length === 0 ? (
        <p class="font-mono text-sm text-muted sm:col-span-2">
          Todavía no hay proyectos publicados. Vuelve pronto.
        </p>
      ) : (
        projects.map((project) => (
          <ProjectCard
            href={`/projects/${project.id}`}
            title={project.data.title}
            description={project.data.description}
            tech={project.data.tech}
            repo={project.data.repo}
            demo={project.data.demo}
          />
        ))
      )
    }
  </div>
</BaseLayout>
