---
import { getCollection } from "astro:content";
import { BaseLayout, ProjectCard } from "@ranydev/theme";
import "../../styles/global.css";

const work = (
  await getCollection("work", ({ data }) => !data.draft)
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Work"
  description="Tools and experiments from the lab — software I build and ship."
>
  <header class="max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">work</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight md:text-5xl">
      Work
    </h1>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">
      Tools I build and experiments I run. Everything here is real software,
      not slides.
    </p>
  </header>

  <div class="mt-12 grid gap-4 sm:grid-cols-2">
    {
      work.length === 0 ? (
        <p class="font-mono text-sm text-muted sm:col-span-2">
          Nothing published yet. Check back soon.
        </p>
      ) : (
        work.map((item) => (
          <ProjectCard
            href={`/work/${item.id}`}
            title={item.data.title}
            description={item.data.description}
            tech={item.data.tech}
            repo={item.data.repo}
            demo={item.data.demo}
            kind={item.data.kind}
            status={item.data.status}
          />
        ))
      )
    }
  </div>
</BaseLayout>
